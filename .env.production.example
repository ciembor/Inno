# Copying this file is not necessary: scripts/deploy-production.sh creates .env
# on the server once and never overwrites it. Change values there, not here.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=maciej-ciemborowicz.eu
DJANGO_CSRF_TRUSTED_ORIGINS=https://maciej-ciemborowicz.eu
DJANGO_FORCE_SCRIPT_NAME=/inno
SQLITE_DB_PATH=/home/ciembor/innoradar/data/db.sqlite3
STATIC_ROOT=/var/www/innoradar/static
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
DJANGO_CACHE_URL=redis://127.0.0.1:6379/4
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=replace-with-the-production-key
DJANGO_ENFORCE_INITIAL_ADMIN_PASSWORD_CHANGE=true
PRIVACY_CONTACT_EMAIL=privacy@innoradar.pl
PRIVACY_CONTROLLER_NAME=operator-serwisu-innoradar
